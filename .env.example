# CodeVideoCanvas — 环境变量示例
# 复制为 .env.local 或 .env 后按需修改；以下均为可选项。
#
# 注意：生产环境下 StepFun (阶跃星辰) API Key 由应用「设置」页写入本地 SQLite 的 settings 表。
# 开发和测试阶段，可以直接在环境变量中配置 STEPFUN_API_KEY。

# 本地数据目录 (SQLite 数据库 + 渲染产物)；默认 ./.data
# DATA_DIR=./.data

# StepFun (阶跃星辰) 开发者/测试配置
STEPFUN_API_KEY=your_stepfun_api_key_here     # 开发期种子 Key；若 SQLite settings 表中无 Key 则读取此变量
STEPFUN_BASE_URL=https://api.stepfun.com/v1   # StepFun API Base URL；默认 https://api.stepfun.com/v1
STEPFUN_CHAT_MODEL=step-3.5-flash             # 文本生成模型 (分镜拆分/脚本撰写/HTML生成)
STEPFUN_TTS_MODEL=stepaudio-2.5-tts           # 配音/声音克隆模型
STEPFUN_ASR_MODEL=stepaudio-2.5-asr           # 语音转写模型 (用于字幕时间轴对齐)
STEPFUN_VISION_MODEL=step-1.5v                # 视觉模型验收节点 (多模态)
