{
  "name": "code-video-canvas",
  "buildCommand": "next build",
  "installCommand": "pnpm install",
  "outputDirectory": "out",
  "nodeVersion": "22.11.0",
  "redirects": [],
  "headers": [
    {
      "source": "/_next/static/*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "cloudFunctions": {
    "mainlandRegions": ["ap-guangzhou"],
    "nodejs": { "maxDuration": 30 }
  }
}
