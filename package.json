{
  "name": "code-video-canvas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:trigger": "trigger dev --skip-update-check",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "verify:v3": "tsx scripts/verify/v3-architecture.ts --check",
    "report:v3": "tsx scripts/verify/v3-architecture.ts --report",
    "test": "vitest run",
    "test:pg": "vitest run --config vitest.pg.config.ts",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/setup/db-migrate.ts",
    "tsc": "tsc"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@trigger.dev/react-hooks": "4.5.7",
    "@trigger.dev/sdk": "4.5.7",
    "@xyflow/react": "^12.11.2",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "ffmpeg-static": "^5.3.0",
    "gsap": "^3.15.0",
    "hyperframes": "0.7.70",
    "jimp": "^1.6.1",
    "lucide-react": "^1.26.0",
    "motion": "^12.42.2",
    "next": ">=16.2.0",
    "openai": "^6.48.0",
    "playwright": "^1.61.1",
    "postgres": "3.4.9",
    "react": ">=19.2",
    "react-dom": ">=19.2",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^0.81.1",
    "@earendil-works/pi-ai": "^0.81.1",
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4.0.0",
    "@trigger.dev/build": "4.5.7",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "^22.11.0",
    "@types/react": ">=19.2",
    "@types/react-dom": ">=19.2",
    "better-sqlite3": "12.1.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.0.0",
    "eslint-config-next": ">=16.2.0",
    "tailwindcss": "^4.0.0",
    "trigger.dev": "4.5.7",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "ffmpeg-static"
    ],
    "overrides": {
      "typescript-eslint": "8.61.1",
      "@typescript-eslint/eslint-plugin": "8.61.1",
      "@typescript-eslint/parser": "8.61.1",
      "better-sqlite3": "12.1.0"
    }
  }
}
